Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options
        - /Status
        - /RobotModel
        - /TF
      Splitter Ratio: 0.5
    Tree Height: 557
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose
      - /Publish Point
    Name: Tool Properties
    Splitter Ratio: 0.588679
  - Class: rviz_common/Views
    Expanded:
      - /Current View
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Class: rviz_common/RobotModel
      Collision Alpha: 1
      Enabled: true
      Links:
        All Links Enabled: true
        Expanded:
          - world
          - base_link
          - base_plate
          - forward_drive_arm
          - horizontal_arm
          - claw_support
          - gripper_left
          - gripper_right
        Link Tree Style: Links in Alphabetic Order
      Mass Properties:
        Inertia: false
        Mass: false
      Name: RobotModel
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_common/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Alpha: 1
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_common/Interact
      Hide Inactive Objects: true
    - Class: rviz_common/MoveCamera
    - Class: rviz_common/Select
    - Class: rviz_common/FocusCamera
    - Class: rviz_common/Measure
      Class Name: rviz_common/Measure
    - Class: rviz_plugins/PublishPoint
      Single click publishing: true
      Topic: /clicked_point
    - Class: rviz_common/SetInitialPose
      Topic: /initialpose
    - Class: rviz_common/SetGoal
      Topic: /goal_pose
  Transformation:
    Current:
      Class: rviz_common/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_common/XYOrbit
      Distance: 1.5
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.2
        Y: 0.2
        Z: 0.3
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.785398
      Target Frame: world
      Value: XYOrbit (rviz_common)
      Yaw: 0.785398
    Saved: []
Window Geometry:
  Displays:
    collapsed: false
    height: 846
    width: 1512
  Height: 846
  Hide Left Dock: false
  Hide Right Dock: false
  Selection:
    collapsed: false
    height: 302
    width: 278
  Tool Properties:
    collapsed: false
    height: 0
    width: 278
  Views:
    collapsed: false
    height: 240
    width: 278
  Width: 1512
  X: 408
  Y: 23
