<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="industrial_arm">

  <xacro:property name="PI" value="3.14159265359"/>
  <xacro:property name="mesh_scale" value="0.01 0.01 0.01"/>
  <xacro:property name="joint_effort" value="30.0"/>
  <xacro:property name="joint_velocity" value="2.0"/>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${(1/12) * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12) * mass * (x*x + z*z)}" iyz="0.0"
               izz="${(1/12) * mass * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <link name="world"/>

  <joint name="virtual_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="-0.5 -0.5 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://industrial_arm_description/meshes/base_link.stl" scale="${mesh_scale}"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><cylinder radius="0.1" length="0.03"/></geometry>
    </collision>
    <xacro:box_inertial mass="1.5" x="0.2" y="0.2" z="0.03"/>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="base_plate"/>
    <origin xyz="0 0 0.0307" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${PI}" upper="${PI}" effort="${joint_effort}" velocity="${joint_velocity}"/>
  </joint>

  <link name="base_plate">
    <visual>
      <origin xyz="-0.39 -0.39 -0.56" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://industrial_arm_description/meshes/base_plate.stl" scale="${mesh_scale}"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.03"/></geometry>
    </collision>
    <xacro:box_inertial mass="1.0" x="0.16" y="0.16" z="0.03"/>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="base_plate"/>
    <child link="forward_drive_arm"/>
    <origin xyz="0 0 0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-${PI/2}" upper="${PI/2}" effort="${joint_effort}" velocity="${joint_velocity}"/>
  </joint>

  <link name="forward_drive_arm">
    <visual>
      <origin xyz="0.19 0.06 -0.08" rpy="0 -${PI/2} ${PI/2}"/>
      <geometry>
        <mesh filename="package://industrial_arm_description/meshes/forward_drive_arm.stl" scale="${mesh_scale}"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.1"/></geometry>
    </collision>
    <xacro:box_inertial mass="0.8" x="0.04" y="0.04" z="0.1"/>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="forward_drive_arm"/>
    <child link="horizontal_arm"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-${PI/2}" upper="${PI/2}" effort="${joint_effort}" velocity="${joint_velocity}"/>
  </joint>

  <link name="horizontal_arm">
    <visual>
      <origin xyz="0.03 -0.4 -0.06" rpy="${PI/2} 0 ${PI/2}"/>
      <geometry>
        <mesh filename="package://industrial_arm_description/meshes/horizontal_arm.stl" scale="${mesh_scale}"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
    </collision>
    <xacro:box_inertial mass="0.5" x="0.12" y="0.03" z="0.03"/>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="horizontal_arm"/>
    <child link="claw_support"/>
    <origin xyz="0.082 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${PI/2}" upper="${PI/2}" effort="${joint_effort}" velocity="${joint_velocity}"/>
  </joint>

  <link name="claw_support">
    <visual>
      <origin rpy="0 0 ${PI/2}" xyz="0 -0.05 -0.15"/>
      <geometry>
        <mesh filename="package://industrial_arm_description/meshes/claw_support.stl" scale="${mesh_scale}"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.01 0 0" rpy="0 0 0"/>
      <geometry><box size="0.03 0.05 0.04"/></geometry>
    </collision>
    <xacro:box_inertial mass="0.3" x="0.03" y="0.05" z="0.04"/>
  </link>

  <joint name="joint5_right" type="prismatic">
    <parent link="claw_support"/>
    <child link="gripper_right"/>
    <origin xyz="0.01 -0.004 -0.01" rpy="0 0 -${PI/2}"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.022" effort="10.0" velocity="0.5"/>
  </joint>

  <link name="gripper_right">
    <visual>
      <origin xyz="-0.1 0.5 -0.1" rpy="0 0 -${PI/2}"/>
      <geometry>
        <mesh filename="package://industrial_arm_description/meshes/gripper_right.stl" scale="${mesh_scale}"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.01 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.01 0.02"/></geometry>
    </collision>
    <xacro:box_inertial mass="0.05" x="0.02" y="0.01" z="0.02"/>
  </link>

  <joint name="joint5_left" type="prismatic">
    <parent link="claw_support"/>
    <child link="gripper_left"/>
    <origin xyz="0.01 0.004 -0.01" rpy="0 0 -${PI/2}"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.022" effort="10.0" velocity="0.5"/>
    <mimic joint="joint5_right" multiplier="1"/>
  </joint>

  <link name="gripper_left">
    <visual>
      <origin xyz="-0.04 0.5 -0.1" rpy="0 0 -${PI/2}"/>
      <geometry>
        <mesh filename="package://industrial_arm_description/meshes/gripper_left.stl" scale="${mesh_scale}"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.01 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.01 0.02"/></geometry>
    </collision>
    <xacro:box_inertial mass="0.05" x="0.02" y="0.01" z="0.02"/>
  </link>

</robot>