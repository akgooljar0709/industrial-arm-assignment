<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>industrial_arm_description</name>
  <version>1.0.0</version>
  <description>Industrial Arm Robot Description - URDF/Xacro and MoveIt 2 configuration for a 5-DOF robotic manipulator with parallel gripper</description>
  <maintainer email="robotics@industrial-arm.local">Industrial Robotics Team</maintainer>
  <license>BSD-3-Clause</license>

  <url type="website">https://github.com/akgooljar0709/industrial-arm-assignment</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>urdf</depend>
  <depend>xacro</depend>
  <depend>rviz2</depend>
  <depend>joint_state_publisher_gui</depend>
  <depend>robot_state_publisher</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit2_setup_assistant</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
